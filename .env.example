# Copy to .env.local and fill in real values. .env.local is git-ignored.

# Supabase — client-safe (anon key is designed to be public behind RLS).
# This app reads only the VITE_* names.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Aloware — SERVER-ONLY. Used only by app/api/sms-signup to forward
# opted-in contacts. The server accepts either ALOWARE_* or VITE_ALOWARE_*.
ALOWARE_API_TOKEN=
VITE_ALOWARE_API_TOKEN=
ALOWARE_DIALER_URL=https://app.aloware.com
VITE_ALOWARE_DIALER_URL=https://app.aloware.com

# Optional Aloware routing
# ALOWARE_TAG_ID=
# ALOWARE_LINE_ID=
# ALOWARE_RING_GROUP_ID=

# HubSpot live chat / chatflow integration.
# Hub (portal) ID — found in HubSpot under Settings > Account Setup > Account
# Defaults & Tracking, or in your tracking-code embed snippet. The chat widget
# only loads when this is set.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
# Optional HubSpot data-center region, e.g. na1, na2, eu1. Leave blank unless
# your tracking-code snippet uses a region-specific host (js-na2.hs-scripts.com).
NEXT_PUBLIC_HUBSPOT_REGION=
